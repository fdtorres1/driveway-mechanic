---
interface Spec {
  fastener: string;
  torqueNm: string;
  torqueFtLb: string;
  note?: string;
}

interface Props {
  specs: Spec[];
  title?: string;
}

const { specs, title = "Torque Specifications" } = Astro.props;
---

<div class="not-prose my-8 rounded-2xl border border-indigo-500/20 bg-gradient-to-br from-indigo-500/5 to-transparent">
  <div class="border-b border-indigo-500/20 px-6 py-4">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-indigo-600 dark:text-indigo-400">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {title}
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-sm" role="table">
      <thead>
        <tr class="border-b border-indigo-500/10 text-left">
          <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wide text-foreground/60">Fastener</th>
          <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wide text-foreground/60">N·m</th>
          <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wide text-foreground/60">ft·lb</th>
          <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wide text-foreground/60">Notes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-indigo-500/10">
        {specs.map((spec) => (
          <tr class="hover:bg-indigo-500/5 transition-colors">
            <td class="px-6 py-3 font-medium text-foreground">{spec.fastener}</td>
            <td class="px-6 py-3">
              <span class="inline-flex items-center rounded-lg bg-indigo-500/10 px-2.5 py-1 text-sm font-bold text-indigo-700 dark:text-indigo-300">
                {spec.torqueNm}
              </span>
            </td>
            <td class="px-6 py-3">
              <span class="inline-flex items-center rounded-lg bg-foreground/5 px-2.5 py-1 text-sm font-bold text-foreground">
                {spec.torqueFtLb}
              </span>
            </td>
            <td class="px-6 py-3 text-foreground/70">{spec.note || "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="border-t border-indigo-500/10 px-6 py-3">
    <p class="text-xs text-foreground/50">
      ⚠️ Torque values are for clean, dry threads unless otherwise noted. Lubricated threads require reduced torque.
    </p>
  </div>
</div>
