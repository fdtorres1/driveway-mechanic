---
interface Props {
  url: string;
  title?: string;
  timestamp?: string;
}

const { url, title = "Watch This Step", timestamp } = Astro.props;

const getEmbedUrl = (rawUrl: string, ts?: string): string => {
  let videoId = "";
  let embedUrl = "";

  if (rawUrl.includes("youtu.be/")) {
    videoId = rawUrl.split("youtu.be/")[1]?.split(/[?&#]/)[0] || "";
  } else if (rawUrl.includes("youtube.com/watch")) {
    const params = new URL(rawUrl).searchParams;
    videoId = params.get("v") || "";
  } else if (rawUrl.includes("youtube.com/embed/")) {
    videoId = rawUrl.split("youtube.com/embed/")[1]?.split(/[?&#]/)[0] || "";
  }

  if (videoId) {
    embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}`;
    const embedParams = new URLSearchParams();
    embedParams.set("rel", "0");
    if (ts) {
      const seconds = parseTimestamp(ts);
      if (seconds > 0) embedParams.set("start", String(seconds));
    }
    embedUrl += `?${embedParams.toString()}`;
  }

  return embedUrl;
};

const parseTimestamp = (ts: string): number => {
  const parts = ts.split(":").map(Number);
  if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
  if (parts.length === 2) return parts[0] * 60 + parts[1];
  return parts[0] || 0;
};

const embedUrl = getEmbedUrl(url, timestamp);
---

<div class="not-prose my-8 rounded-2xl border border-red-500/20 bg-gradient-to-br from-red-500/5 to-transparent overflow-hidden">
  <div class="border-b border-red-500/20 px-6 py-4">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-red-600 dark:text-red-400">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      {title}
    </div>
    {timestamp && (
      <p class="mt-1 text-sm text-foreground/60">Jump to {timestamp}</p>
    )}
  </div>

  {embedUrl ? (
    <div class="relative w-full" style="padding-bottom: 56.25%;">
      <iframe
        src={embedUrl}
        title={title}
        class="absolute inset-0 h-full w-full"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  ) : (
    <div class="px-6 py-8 text-center">
      <p class="text-sm text-foreground/60">
        <a href={url} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline dark:text-blue-400">
          Watch video →
        </a>
      </p>
    </div>
  )}
</div>
