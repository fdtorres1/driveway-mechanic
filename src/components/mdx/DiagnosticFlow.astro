---
interface Step {
  stepNumber?: number;
  title: string;
  details?: string;
  outcome?: string;
  nextIfPass?: string;
  nextIfFail?: string;
  safetyNote?: string;
}

interface Props {
  title?: string;
  intro?: string;
  steps: Step[];
  whenToCallPro?: string;
}

const { title, intro, steps, whenToCallPro } = Astro.props;
---

<div class="not-prose my-8 rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/5 to-transparent">
  <div class="border-b border-accent/20 px-6 py-4">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-accent">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      Diagnostic Flow — Check These in Order
    </div>
    {title && <h3 class="mt-2 text-lg font-semibold text-foreground">{title}</h3>}
    {intro && <p class="mt-1 text-sm text-foreground/70">{intro}</p>}
  </div>

  <div class="divide-y divide-accent/10">
    {steps.map((step, index) => (
      <div class="px-6 py-5">
        <div class="flex gap-4">
          <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-accent text-sm font-bold text-white">
            {step.stepNumber || index + 1}
          </div>
          <div class="min-w-0 flex-1">
            <h4 class="font-semibold text-foreground">{step.title}</h4>
            
            {step.details && (
              <p class="mt-2 text-sm text-foreground/80">{step.details}</p>
            )}

            {step.safetyNote && (
              <div class="mt-3 flex items-start gap-2 rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-2 text-sm">
                <span class="text-red-500">⚠️</span>
                <span class="text-foreground/85">{step.safetyNote}</span>
              </div>
            )}

            {step.outcome && (
              <div class="mt-3 rounded-lg bg-foreground/5 px-3 py-2 text-sm">
                <span class="font-medium text-foreground/70">Look for: </span>
                <span class="text-foreground/80">{step.outcome}</span>
              </div>
            )}

            {(step.nextIfPass || step.nextIfFail) && (
              <div class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
                {step.nextIfPass && (
                  <div class="flex items-start gap-2 rounded-lg border border-emerald-500/20 bg-emerald-500/10 px-3 py-2">
                    <span class="text-emerald-600 dark:text-emerald-400">✓</span>
                    <span class="text-foreground/80">{step.nextIfPass}</span>
                  </div>
                )}
                {step.nextIfFail && (
                  <div class="flex items-start gap-2 rounded-lg border border-amber-500/20 bg-amber-500/10 px-3 py-2">
                    <span class="text-amber-600 dark:text-amber-400">✗</span>
                    <span class="text-foreground/80">{step.nextIfFail}</span>
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  {whenToCallPro && (
    <div class="border-t border-accent/20 px-6 py-4">
      <div class="flex items-start gap-3 rounded-xl bg-foreground/5 px-4 py-3">
        <span class="text-lg">🔧</span>
        <div>
          <div class="text-xs font-semibold uppercase tracking-wide text-foreground/70">When to Call a Professional</div>
          <p class="mt-1 text-sm text-foreground/80">{whenToCallPro}</p>
        </div>
      </div>
    </div>
  )}
</div>