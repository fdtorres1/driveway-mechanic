---
interface Props {
  name: string;
  image?: string;
  rating?: number;
  price?: string;
  originalPrice?: string;
  description?: string;
  pros?: string[];
  cons?: string[];
  fitment?: string[]; // Vehicle compatibility
  partNumber?: string;
  tier?: "budget" | "oem" | "performance";
  affiliateUrl: string;
  bestFor?: string;
}

const { 
  name, 
  image, 
  rating, 
  price, 
  originalPrice, 
  description, 
  pros = [], 
  cons = [], 
  fitment = [],
  partNumber,
  tier,
  affiliateUrl,
  bestFor
} = Astro.props;

const tierConfig = {
  budget: {
    label: "Budget Choice",
    color: "text-blue-600 dark:text-blue-400",
    bg: "bg-blue-500/10",
    border: "border-blue-500/20",
  },
  oem: {
    label: "OEM Quality",
    color: "text-emerald-600 dark:text-emerald-400",
    bg: "bg-emerald-500/10",
    border: "border-emerald-500/20",
  },
  performance: {
    label: "Performance",
    color: "text-purple-600 dark:text-purple-400",
    bg: "bg-purple-500/10",
    border: "border-purple-500/20",
  },
};

const tierStyle = tier ? tierConfig[tier] : null;
---

<div class="not-prose my-6 overflow-hidden rounded-2xl border border-foreground/10 bg-foreground/[.02]">
  <div class="p-6">
    <div class="flex flex-col gap-6 sm:flex-row">
      <!-- Product Image -->
      {image && (
        <div class="shrink-0 sm:w-32">
          <img 
            src={image} 
            alt={name}
            class="aspect-square w-full rounded-lg bg-foreground/5 object-cover"
            loading="lazy"
          />
        </div>
      )}

      <!-- Product Info -->
      <div class="min-w-0 flex-1">
        <div class="mb-3">
          <h4 class="text-lg font-semibold text-foreground">{name}</h4>
          
          <div class="mt-2 flex flex-wrap items-center gap-2">
            {rating && (
              <div class="flex items-center gap-1 text-sm">
                <div class="flex text-amber-400">
                  {Array.from({ length: 5 }, (_, i) => (
                    <span class={i < rating ? 'text-amber-400' : 'text-foreground/20'}>★</span>
                  ))}
                </div>
                <span class="text-foreground/60">({rating}/5)</span>
              </div>
            )}
            
            {tier && tierStyle && (
              <span class={`rounded-full px-2 py-0.5 text-xs font-medium ${tierStyle.color} ${tierStyle.bg}`}>
                {tierStyle.label}
              </span>
            )}
          </div>

          {partNumber && (
            <div class="mt-1 text-xs text-foreground/50">Part #: {partNumber}</div>
          )}
        </div>

        {description && (
          <p class="text-sm text-foreground/80">{description}</p>
        )}

        {fitment.length > 0 && (
          <div class="mt-3">
            <div class="text-xs font-medium text-foreground/70 mb-1">Compatible with:</div>
            <div class="flex flex-wrap gap-1">
              {fitment.map((vehicle) => (
                <span class="rounded bg-foreground/10 px-2 py-1 text-xs text-foreground/80">
                  {vehicle}
                </span>
              ))}
            </div>
          </div>
        )}

        {bestFor && (
          <div class="mt-3 rounded-lg bg-emerald-500/10 px-3 py-2 text-sm">
            <span class="font-medium text-emerald-700 dark:text-emerald-400">Best for: </span>
            <span class="text-foreground/80">{bestFor}</span>
          </div>
        )}

        {(pros.length > 0 || cons.length > 0) && (
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {pros.length > 0 && (
              <div>
                <div class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 mb-1">Pros</div>
                <ul class="space-y-1">
                  {pros.map((pro) => (
                    <li class="flex items-start gap-2 text-sm">
                      <span class="text-emerald-500">✓</span>
                      <span class="text-foreground/80">{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {cons.length > 0 && (
              <div>
                <div class="text-xs font-semibold text-red-600 dark:text-red-400 mb-1">Cons</div>
                <ul class="space-y-1">
                  {cons.map((con) => (
                    <li class="flex items-start gap-2 text-sm">
                      <span class="text-red-500">✗</span>
                      <span class="text-foreground/80">{con}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
      </div>

      <!-- Price & CTA -->
      <div class="flex shrink-0 flex-col justify-between sm:w-32 sm:text-right">
        {price && (
          <div class="mb-3">
            <div class="text-lg font-bold text-foreground">{price}</div>
            {originalPrice && (
              <div class="text-sm text-foreground/50 line-through">{originalPrice}</div>
            )}
          </div>
        )}

        <a
          href={affiliateUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-600"
        >
          Check Price
          <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>