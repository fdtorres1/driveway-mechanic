---
interface AftermarketPart {
  brand: string;
  number: string;
  url?: string;
}

interface Part {
  name: string;
  oem: string;
  aftermarket?: AftermarketPart[];
}

interface Props {
  parts: Part[];
  vehicle?: string;
}

const { parts, vehicle } = Astro.props;
---

<div class="not-prose my-8 rounded-2xl border border-cyan-500/20 bg-gradient-to-br from-cyan-500/5 to-transparent">
  <div class="border-b border-cyan-500/20 px-6 py-4">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-cyan-600 dark:text-cyan-400">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
      </svg>
      Part Numbers
    </div>
    {vehicle && (
      <p class="mt-1 text-sm text-foreground/70">For: {vehicle}</p>
    )}
  </div>

  <div class="divide-y divide-cyan-500/10">
    {parts.map((part) => (
      <div class="px-6 py-4">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h4 class="font-semibold text-foreground">{part.name}</h4>
            <div class="mt-1 flex items-center gap-2">
              <span class="text-xs font-medium uppercase tracking-wide text-foreground/50">OEM</span>
              <span class="inline-flex items-center rounded-lg bg-cyan-500/10 px-3 py-1 text-sm font-bold text-cyan-700 dark:text-cyan-300 font-mono">
                {part.oem}
              </span>
            </div>
          </div>
        </div>

        {part.aftermarket && part.aftermarket.length > 0 && (
          <div class="mt-3">
            <div class="text-xs font-medium uppercase tracking-wide text-foreground/50 mb-2">Aftermarket Alternatives</div>
            <div class="flex flex-wrap gap-2">
              {part.aftermarket.map((alt) => (
                <div class="inline-flex items-center gap-2 rounded-lg border border-foreground/10 bg-foreground/[.03] px-3 py-1.5">
                  <span class="text-xs font-medium text-foreground/70">{alt.brand}</span>
                  {alt.url ? (
                    <a
                      href={alt.url}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="font-mono text-sm font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
                    >
                      {alt.number}
                    </a>
                  ) : (
                    <span class="font-mono text-sm font-semibold text-foreground">{alt.number}</span>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</div>
