---
interface Props {
  level: 1 | 2 | 3 | 4 | 5;
  label?: string;
  description?: string;
}

const { level, label, description } = Astro.props;

const segmentColors = [
  "bg-emerald-500",
  "bg-lime-500",
  "bg-yellow-500",
  "bg-orange-500",
  "bg-red-500",
];

const defaultLabels: Record<number, string> = {
  1: "Easy",
  2: "Straightforward",
  3: "Moderate",
  4: "Challenging",
  5: "Expert",
};

const defaultDescriptions: Record<number, string> = {
  1: "Anyone can do this with basic tools",
  2: "Some mechanical aptitude helpful",
  3: "Requires comfort working under the car",
  4: "Needs specialized tools and experience",
  5: "Professional-level skill required",
};

const displayLabel = label || defaultLabels[level];
const displayDescription = description || defaultDescriptions[level];
---

<div class="not-prose my-6 inline-flex items-center gap-4 rounded-2xl border border-foreground/10 bg-foreground/[.02] px-5 py-3">
  <div class="flex items-center gap-2">
    <svg class="h-5 w-5 text-foreground/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
    </svg>
    <span class="text-xs font-semibold uppercase tracking-wide text-foreground/50">Difficulty</span>
  </div>

  <div class="flex items-center gap-1.5" role="meter" aria-label={`Difficulty: ${displayLabel}`} aria-valuenow={level} aria-valuemin={1} aria-valuemax={5}>
    {Array.from({ length: 5 }, (_, i) => (
      <div
        class={`h-3 w-8 rounded-full transition-colors ${i < level ? segmentColors[i] : "bg-foreground/10"}`}
      />
    ))}
  </div>

  <div>
    <div class="text-sm font-semibold text-foreground">{displayLabel}</div>
    <div class="text-xs text-foreground/60">{displayDescription}</div>
  </div>
</div>
