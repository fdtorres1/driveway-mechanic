---
interface Item {
  name: string;
  description?: string;
  affiliateUrl?: string;
  priceRange?: string;
}

interface Props {
  title?: string;
  mustHave?: Item[];
  niceToHave?: Item[];
  safetyGear?: Item[];
  disclaimer?: string;
}

const {
  title = "Tools & Parts You'll Need",
  mustHave = [],
  niceToHave = [],
  safetyGear = [],
  disclaimer = "Some links may be affiliate links.",
} = Astro.props;

const hasMustHave = mustHave.length > 0;
const hasNiceToHave = niceToHave.length > 0;
const hasSafetyGear = safetyGear.length > 0;

if (!hasMustHave && !hasNiceToHave && !hasSafetyGear) {
  return null;
}
---

<div class="not-prose my-8 rounded-2xl border border-foreground/10 bg-foreground/[.02]">
  <div class="border-b border-foreground/10 px-6 py-4">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-foreground/70">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {title}
    </div>
  </div>

  <div class="grid gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">
    {hasMustHave && (
      <div>
        <h4 class="mb-3 flex items-center gap-2 text-sm font-semibold text-foreground">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 text-xs text-emerald-600 dark:text-emerald-400">✓</span>
          Must-Have
        </h4>
        <ul class="space-y-2">
          {mustHave.map((item) => (
            <li class="flex items-start gap-3">
              <span class="text-sm text-emerald-500">•</span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-x-2">
                  {item.affiliateUrl ? (
                    <a
                      href={item.affiliateUrl}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="font-medium text-foreground hover:text-blue-600 hover:underline dark:hover:text-blue-400"
                    >
                      {item.name}
                    </a>
                  ) : (
                    <span class="font-medium text-foreground">{item.name}</span>
                  )}
                  {item.priceRange && <span class="text-xs text-foreground/60">{item.priceRange}</span>}
                </div>
                {item.description && <p class="mt-0.5 text-sm text-foreground/70">{item.description}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}

    {hasNiceToHave && (
      <div>
        <h4 class="mb-3 flex items-center gap-2 text-sm font-semibold text-foreground">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-blue-500/20 text-xs text-blue-600 dark:text-blue-400">+</span>
          Nice-to-Have
        </h4>
        <ul class="space-y-2">
          {niceToHave.map((item) => (
            <li class="flex items-start gap-3">
              <span class="text-sm text-blue-500">◦</span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-x-2">
                  {item.affiliateUrl ? (
                    <a
                      href={item.affiliateUrl}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="font-medium text-foreground hover:text-blue-600 hover:underline dark:hover:text-blue-400"
                    >
                      {item.name}
                    </a>
                  ) : (
                    <span class="font-medium text-foreground">{item.name}</span>
                  )}
                  {item.priceRange && <span class="text-xs text-foreground/60">{item.priceRange}</span>}
                </div>
                {item.description && <p class="mt-0.5 text-sm text-foreground/70">{item.description}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}

    {hasSafetyGear && (
      <div>
        <h4 class="mb-3 flex items-center gap-2 text-sm font-semibold text-foreground">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-500/20 text-xs text-amber-600 dark:text-amber-400">!</span>
          Safety Gear
        </h4>
        <ul class="space-y-2">
          {safetyGear.map((item) => (
            <li class="flex items-start gap-3">
              <span class="text-sm text-amber-500">⚡</span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-x-2">
                  {item.affiliateUrl ? (
                    <a
                      href={item.affiliateUrl}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="font-medium text-foreground hover:text-blue-600 hover:underline dark:hover:text-blue-400"
                    >
                      {item.name}
                    </a>
                  ) : (
                    <span class="font-medium text-foreground">{item.name}</span>
                  )}
                  {item.priceRange && <span class="text-xs text-foreground/60">{item.priceRange}</span>}
                </div>
                {item.description && <p class="mt-0.5 text-sm text-foreground/70">{item.description}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  {disclaimer && (
    <div class="border-t border-foreground/10 px-6 py-3">
      <p class="text-xs text-foreground/50">{disclaimer}</p>
    </div>
  )}
</div>
