---
/**
 * GoChecklist Component
 * 
 * A compact, printable checklist for readiness items (go-bags, evacuation, etc.)
 * 
 * Usage in MDX:
 * <GoChecklist
 *   title="Family Go-Bag Checklist"
 *   timeEstimate="30 minutes to pack"
 *   items={[
 *     { label: "Water (1 gallon per person per day)", category: "water" },
 *     { label: "Flashlight + extra batteries", category: "power" }
 *   ]}
 * />
 */

interface ChecklistItem {
  label: string;
  category?: string;
  notes?: string;
}

interface Props {
  title: string;
  timeEstimate?: string;
  items: ChecklistItem[];
  printable?: boolean;
}

const { 
  title, 
  timeEstimate,
  items = [],
  printable = true
} = Astro.props;

// Group items by category
const grouped = items.reduce((acc, item) => {
  const cat = item.category || "general";
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(item);
  return acc;
}, {} as Record<string, ChecklistItem[]>);

const categoryLabels: Record<string, { label: string; icon: string }> = {
  water: { label: "Water & Food", icon: "💧" },
  power: { label: "Power & Light", icon: "🔦" },
  documents: { label: "Documents", icon: "📄" },
  clothing: { label: "Clothing", icon: "👕" },
  medical: { label: "Medical & First Aid", icon: "🩹" },
  pets: { label: "Pets", icon: "🐾" },
  kids: { label: "Kids", icon: "👶" },
  tools: { label: "Tools & Supplies", icon: "🔧" },
  communication: { label: "Communication", icon: "📱" },
  general: { label: "General", icon: "📦" },
};
---

<div class="not-prose my-8 rounded-xl border border-foreground/10 overflow-hidden print:border-black">
  <div class="bg-foreground/[.02] px-5 py-4 border-b border-foreground/10 print:bg-white">
    <div class="flex items-center justify-between">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-lg">✅</span>
          <span class="text-xs font-semibold uppercase tracking-wide text-foreground/60">
            Readiness Checklist
          </span>
        </div>
        <h3 class="text-lg font-semibold mt-1">{title}</h3>
        {timeEstimate && (
          <p class="text-sm text-foreground/60 mt-1">⏱️ {timeEstimate}</p>
        )}
      </div>
      {printable && (
        <button 
          onclick="window.print()"
          class="text-sm px-3 py-1.5 rounded-lg border border-foreground/10 hover:bg-foreground/5 transition-colors print:hidden"
        >
          🖨️ Print
        </button>
      )}
    </div>
  </div>

  <div class="p-5 space-y-6">
    {Object.entries(grouped).map(([category, categoryItems]) => {
      const catInfo = categoryLabels[category] || categoryLabels.general;
      return (
        <div>
          <h4 class="flex items-center gap-2 font-semibold text-sm mb-3">
            <span>{catInfo.icon}</span>
            {catInfo.label}
          </h4>
          <ul class="space-y-2">
            {categoryItems.map((item) => (
              <li class="flex items-start gap-3">
                <input 
                  type="checkbox" 
                  class="mt-1 h-4 w-4 rounded border-foreground/20 print:border-black"
                />
                <div>
                  <span class="text-sm">{item.label}</span>
                  {item.notes && (
                    <p class="text-xs text-foreground/60 mt-0.5">{item.notes}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>

  <div class="bg-foreground/[.02] px-5 py-3 border-t border-foreground/10 print:bg-white">
    <p class="text-xs text-foreground/50">
      💡 Tip: Review and refresh this checklist quarterly. Check expiration dates on food, water, and medications.
    </p>
  </div>
</div>
