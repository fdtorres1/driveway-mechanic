---
interface Props {
  severity?: "warning" | "danger";
  title?: string;
  bullets?: string[];
  callProMessage?: string;
}

const { severity = "warning", title, bullets, callProMessage } = Astro.props;

const isDanger = severity === "danger";
const styles = isDanger
  ? {
      container: "border-red-500/40 bg-gradient-to-br from-red-500/15 to-red-500/5",
      icon: "bg-red-600",
      label: "text-red-700 dark:text-red-400",
      bullet: "text-red-600 dark:text-red-400",
    }
  : {
      container: "border-amber-500/30 bg-gradient-to-br from-amber-500/15 to-amber-500/5",
      icon: "bg-amber-500",
      label: "text-amber-700 dark:text-amber-400",
      bullet: "text-amber-600 dark:text-amber-400",
    };
---

<div class={`not-prose my-8 rounded-2xl border-2 ${styles.container}`} role="alert">
  <div class="px-6 py-5">
    <div class="flex items-start gap-4">
      <div class={`flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full ${styles.icon} text-white`}>
        {isDanger ? (
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        ) : (
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        )}
      </div>

      <div class="min-w-0 flex-1">
        <div class={`text-xs font-bold uppercase tracking-wider ${styles.label}`}>
          {isDanger ? "🛑 STOP HERE" : "⚠️ WARNING"}
        </div>

        {title && <h3 class="mt-1 text-lg font-bold text-foreground">{title}</h3>}

        <div class="mt-2 text-sm text-foreground/90">
          <slot />
        </div>

        {bullets && bullets.length > 0 && (
          <ul class="mt-3 space-y-1">
            {bullets.map((bullet) => (
              <li class="flex items-start gap-2 text-sm">
                <span class={`font-bold ${styles.bullet}`}>•</span>
                <span class="text-foreground/85">{bullet}</span>
              </li>
            ))}
          </ul>
        )}

        {callProMessage && (
          <div class="mt-4 flex items-center gap-2 rounded-lg bg-foreground/10 px-3 py-2 text-sm">
            <span>👷</span>
            <span class="font-medium text-foreground/80">{callProMessage}</span>
          </div>
        )}
      </div>
    </div>
  </div>
</div>
