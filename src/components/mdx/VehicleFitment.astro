---
interface Props {
  vehicles: string[];
  title?: string;
  note?: string;
}

const { vehicles, title = "Vehicle Compatibility", note } = Astro.props;
---

<div class="not-prose my-6 rounded-xl border border-blue-500/20 bg-gradient-to-br from-blue-500/5 to-transparent p-4">
  <div class="flex items-center gap-2 mb-3">
    <svg class="h-5 w-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <h4 class="text-sm font-semibold text-blue-700 dark:text-blue-400">{title}</h4>
  </div>
  
  <div class="flex flex-wrap gap-2 mb-3">
    {vehicles.map((vehicle) => (
      <span class="inline-flex items-center rounded-full bg-blue-100 dark:bg-blue-900/30 px-3 py-1 text-sm font-medium text-blue-800 dark:text-blue-300">
        <svg class="mr-1.5 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {vehicle}
      </span>
    ))}
  </div>
  
  {note && (
    <p class="text-xs text-foreground/60 italic">{note}</p>
  )}
</div>