---
interface Props {
  time: string;
  diyCost: string;
  shopCost: string;
  skill: "beginner" | "intermediate" | "advanced";
  notes?: string;
}

const { time, diyCost, shopCost, skill, notes } = Astro.props;

const skillConfig = {
  beginner: {
    label: "Beginner",
    description: "No experience needed",
    color: "text-emerald-600 dark:text-emerald-400",
    bg: "bg-emerald-500/15",
    border: "border-emerald-500/30",
    icon: "🔧",
  },
  intermediate: {
    label: "Intermediate",
    description: "Some DIY experience helpful",
    color: "text-blue-600 dark:text-blue-400",
    bg: "bg-blue-500/15",
    border: "border-blue-500/30",
    icon: "⚙️",
  },
  advanced: {
    label: "Advanced",
    description: "Requires specific skills or tools",
    color: "text-amber-600 dark:text-amber-400",
    bg: "bg-amber-500/15",
    border: "border-amber-500/30",
    icon: "🛠️",
  },
};

const skillStyle = skillConfig[skill] || skillConfig.beginner;

// Calculate savings percentage
const extractCost = (costStr: string) => {
  const match = costStr.match(/\$(\d+)/);
  return match ? parseInt(match[1]) : 0;
};

const diyAmount = extractCost(diyCost);
const shopAmount = extractCost(shopCost);
const savings = shopAmount > diyAmount ? shopAmount - diyAmount : 0;
const savingsPercent = shopAmount > 0 ? Math.round((savings / shopAmount) * 100) : 0;
---

<div class="not-prose my-6">
  <div class="inline-flex flex-wrap items-stretch gap-3 rounded-2xl border border-foreground/10 bg-foreground/[.02] p-1">
    <!-- Time -->
    <div class="flex items-center gap-2 rounded-xl bg-foreground/5 px-4 py-2.5">
      <span class="text-lg">⏱️</span>
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-wide text-foreground/50">Time</div>
        <div class="text-sm font-semibold text-foreground">{time}</div>
      </div>
    </div>

    <!-- DIY Cost -->
    <div class="flex items-center gap-2 rounded-xl bg-foreground/5 px-4 py-2.5">
      <span class="text-lg">💰</span>
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-wide text-foreground/50">DIY Cost</div>
        <div class="text-sm font-semibold text-foreground">{diyCost}</div>
      </div>
    </div>

    <!-- Shop Cost -->
    <div class="flex items-center gap-2 rounded-xl bg-foreground/5 px-4 py-2.5">
      <span class="text-lg">🏪</span>
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-wide text-foreground/50">Shop Cost</div>
        <div class="text-sm font-semibold text-foreground/60">{shopCost}</div>
        {savings > 0 && (
          <div class="text-xs text-emerald-600">Save ${savings} ({savingsPercent}%)</div>
        )}
      </div>
    </div>

    <!-- Skill -->
    <div class={`flex items-center gap-2 rounded-xl border ${skillStyle.border} ${skillStyle.bg} px-4 py-2.5`}>
      <span class="text-lg">{skillStyle.icon}</span>
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-wide text-foreground/50">Skill</div>
        <div class={`text-sm font-semibold ${skillStyle.color}`}>{skillStyle.label}</div>
      </div>
    </div>
  </div>

  {notes && <p class="mt-2 text-xs text-foreground/60">{notes}</p>}
</div>