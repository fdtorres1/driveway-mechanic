---
interface Props {
  code: string;
  meaning?: string;
  description?: string;
  severity?: string;
  causes?: string[];
  commonCauses?: string[];
  symptoms?: string[];
  notes?: string;
  canDriveSafely?: boolean;
  urgency?: string;
}

const { 
  code, 
  meaning,
  description, 
  severity = "medium", 
  causes = [],
  commonCauses = [], 
  symptoms = [],
  notes,
  canDriveSafely = false,
  urgency
} = Astro.props;

const displayDescription = meaning || description || "";
const displayCauses = causes.length > 0 ? causes : commonCauses;

const severityConfig: Record<string, { label: string; color: string; bg: string; border: string; icon: string }> = {
  low: {
    label: "Low Priority",
    color: "text-green-700 dark:text-green-400",
    bg: "bg-green-500/10",
    border: "border-green-500/20",
    icon: "ℹ️",
  },
  monitor: {
    label: "Monitor",
    color: "text-green-700 dark:text-green-400",
    bg: "bg-green-500/10",
    border: "border-green-500/20",
    icon: "👁️",
  },
  schedule: {
    label: "Schedule Service",
    color: "text-blue-700 dark:text-blue-400",
    bg: "bg-blue-500/10",
    border: "border-blue-500/20",
    icon: "📅",
  },
  "schedule-soon": {
    label: "Schedule Soon",
    color: "text-amber-700 dark:text-amber-400",
    bg: "bg-amber-500/10",
    border: "border-amber-500/20",
    icon: "⚠️",
  },
  medium: {
    label: "Moderate",
    color: "text-amber-700 dark:text-amber-400",
    bg: "bg-amber-500/10",
    border: "border-amber-500/20",
    icon: "⚠️",
  },
  "urgent-if-flashing": {
    label: "Urgent if Flashing",
    color: "text-red-700 dark:text-red-400",
    bg: "bg-red-500/10",
    border: "border-red-500/20",
    icon: "🚨",
  },
  high: {
    label: "High Priority",
    color: "text-red-700 dark:text-red-400",
    bg: "bg-red-500/10",
    border: "border-red-500/20",
    icon: "🚨",
  },
};

const severityStyle = severityConfig[severity] || severityConfig["medium"];
---

<div class={`not-prose my-6 rounded-2xl border ${severityStyle.border} ${severityStyle.bg}`}>
  <div class="px-6 py-4 border-b border-current/10">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-foreground/10">
          <span class="text-lg">{severityStyle.icon}</span>
        </div>
        <div>
          <h4 class="text-lg font-bold text-foreground">{code}</h4>
          <p class="text-sm text-foreground/80">{displayDescription}</p>
        </div>
      </div>
      
      <div class="text-right shrink-0">
        <div class={`text-xs font-semibold uppercase tracking-wide ${severityStyle.color}`}>
          {severityStyle.label}
        </div>
        <div class={`mt-1 text-xs ${canDriveSafely ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}`}>
          {canDriveSafely ? '✓ Can drive cautiously' : '✗ Avoid driving'}
        </div>
      </div>
    </div>
  </div>

  <div class="p-6">
    {symptoms.length > 0 && (
      <div class="mb-4">
        <h5 class="text-sm font-semibold text-foreground mb-2">Common Symptoms:</h5>
        <ul class="space-y-1">
          {symptoms.map((symptom) => (
            <li class="flex items-start gap-2 text-sm">
              <span class="text-accent">•</span>
              <span class="text-foreground/80">{symptom}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {displayCauses.length > 0 && (
      <div class="mb-4">
        <h5 class="text-sm font-semibold text-foreground mb-2">Likely Causes:</h5>
        <ul class="space-y-1">
          {displayCauses.map((cause) => (
            <li class="flex items-start gap-2 text-sm">
              <span class="text-blue-500">→</span>
              <span class="text-foreground/80">{cause}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {notes && (
      <div class="mb-4 text-sm text-foreground/80">
        <p>{notes}</p>
      </div>
    )}

    {urgency && (
      <div class="mt-4 p-3 rounded-lg bg-foreground/5 border-l-4 border-accent">
        <div class="flex items-start gap-2">
          <span class="text-lg">⏰</span>
          <div>
            <div class="text-xs font-semibold uppercase tracking-wide text-foreground/70">Action Timeline</div>
            <div class="text-sm text-foreground/80 mt-1">{urgency}</div>
          </div>
        </div>
      </div>
    )}
  </div>
</div>