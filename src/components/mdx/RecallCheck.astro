---
interface Props {
  title?: string;
  nhtsaUrl?: string;
}

const {
  title = "Check for Open Recalls",
  nhtsaUrl = "https://www.nhtsa.gov/recalls",
} = Astro.props;
---

<div class="not-prose my-8 rounded-2xl border-2 border-amber-500/30 bg-gradient-to-br from-amber-500/10 to-amber-500/5" role="alert">
  <div class="px-6 py-5">
    <div class="flex items-start gap-4">
      <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-amber-500 text-white">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>

      <div class="min-w-0 flex-1">
        <div class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">
          🔍 Recall Notice
        </div>
        <h3 class="mt-1 text-lg font-bold text-foreground">{title}</h3>
        <p class="mt-2 text-sm text-foreground/80">
          Before starting this repair, check if your vehicle has any open recalls related to this system.
          Recall repairs are always free at the dealer — don't pay for a fix that's covered.
        </p>

        <a
          href={nhtsaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700 transition-colors"
        >
          Check NHTSA Recall Lookup
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
