---
interface Props {
  tone?: "note" | "tip" | "warning" | "info";
}

const { tone = "note" } = Astro.props;

const toneStyles = {
  note: "border-zinc-500/20 bg-zinc-500/10",
  tip: "border-emerald-500/25 bg-emerald-500/10",
  warning: "border-amber-500/30 bg-amber-500/10",
  info: "border-blue-500/25 bg-blue-500/10",
};

const toneLabels = {
  note: "📝 Note",
  tip: "💡 Tip",
  warning: "⚠️ Warning",
  info: "ℹ️ Info",
};
---

<div class={`not-prose my-6 rounded-xl border p-5 ${toneStyles[tone]}`}>
  <div class="text-xs font-semibold uppercase tracking-wide text-foreground/70">
    {toneLabels[tone]}
  </div>
  <div class="mt-2 text-sm text-foreground/90">
    <slot />
  </div>
</div>
