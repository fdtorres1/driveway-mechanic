---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const MAINTAIN_HUBS = ["oil-fluids", "tires", "filters", "belts-hoses", "coolant", "maintenance-schedules"];

const articles = await getCollection("articles", ({ data }) => {
  const inMaintainHub = data.hubs.some((h: string) => MAINTAIN_HUBS.includes(h));
  const isHowTo = data.articleType === "how-to" || data.articleType === "maintenance-schedule";
  return (inMaintainHub || isHowTo) && !data.draft;
});

const sortedArticles = articles.sort((a, b) => {
  const dateA = a.data.publishedAt?.getTime() ?? 0;
  const dateB = b.data.publishedAt?.getTime() ?? 0;
  return dateB - dateA;
});
---

<Layout 
  title="Maintain & Prevent"
  description="DIY car maintenance guides to keep your vehicle running smoothly. Oil changes, brake service, tire rotation, and preventive maintenance done right in your driveway."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-foreground/60">
        <li><a href="/" class="hover:text-foreground">Home</a></li>
        <li>/</li>
        <li class="text-foreground">Maintain & Prevent</li>
      </ol>
    </nav>

    <div class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500 text-white">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h1 class="text-4xl font-bold text-foreground">Maintain & Prevent</h1>
      </div>
      <p class="text-lg text-foreground/70 max-w-3xl">
        Regular maintenance is the cheapest insurance against big repair bills. Our step-by-step
        guides make it easy to keep your car running smoothly — all from your driveway.
      </p>
    </div>

    {sortedArticles.length > 0 && (
      <div class="mb-12 rounded-2xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-transparent p-8">
        <h2 class="text-2xl font-bold text-foreground mb-4">🛠️ Maintenance Guides</h2>
        <p class="text-foreground/70 mb-6">
          Step-by-step guides for the maintenance tasks every car owner should know.
        </p>
        
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {sortedArticles.map((article) => {
            const slug = article.id.replace(/\.mdx?$/, '');
            return (
              <a href={`/maintain/${slug}`} class="group rounded-lg border border-foreground/10 bg-background p-4 hover:bg-foreground/[.02] transition-colors">
                <div class="font-semibold text-foreground group-hover:text-emerald-600">{article.data.title}</div>
                <div class="text-sm text-foreground/60 mt-1">{article.data.excerpt?.slice(0, 80)}…</div>
              </a>
            );
          })}
        </div>
      </div>
    )}

    <div class="mb-12">
      <h2 class="text-2xl font-bold text-foreground mb-6">Browse by Category</h2>
      
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-amber-500/20 bg-gradient-to-br from-amber-500/5 to-transparent p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🛢️</span>
            <h3 class="text-lg font-semibold text-foreground">Oil & Fluids</h3>
          </div>
          <p class="text-sm text-foreground/70">
            Oil changes, coolant flushes, brake fluid, transmission fluid, and power steering
          </p>
        </div>

        <div class="rounded-2xl border border-blue-500/20 bg-gradient-to-br from-blue-500/5 to-transparent p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🛞</span>
            <h3 class="text-lg font-semibold text-foreground">Tires & Wheels</h3>
          </div>
          <p class="text-sm text-foreground/70">
            Tire rotation, pressure checks, alignment signs, and when to replace
          </p>
        </div>

        <div class="rounded-2xl border border-purple-500/20 bg-gradient-to-br from-purple-500/5 to-transparent p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🔋</span>
            <h3 class="text-lg font-semibold text-foreground">Battery & Electrical</h3>
          </div>
          <p class="text-sm text-foreground/70">
            Battery testing, replacement, jump starting, and charging system checks
          </p>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-emerald-500/30 bg-gradient-to-br from-emerald-500/10 to-transparent p-8">
      <div class="flex items-start gap-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-600 text-white shrink-0">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-emerald-700 dark:text-emerald-400 mb-2">Maintenance Saves Money</h3>
          <p class="text-emerald-600 dark:text-emerald-300">
            Skipping a $50 oil change can lead to a $5,000 engine replacement. Regular maintenance
            is the single best way to avoid expensive repairs and keep your car reliable for years.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
