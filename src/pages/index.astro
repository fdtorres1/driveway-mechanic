---
import Layout from "../layouts/Layout.astro";
---

<Layout title="The Driveway Mechanic">
  <!-- Hero Section -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center">
      <div class="mb-8">
        <div class="inline-flex h-20 w-20 items-center justify-center rounded-2xl bg-accent mb-6">
          <span class="text-3xl text-white">🔧</span>
        </div>
        <h1 class="text-5xl font-bold text-foreground mb-4">
          The Driveway Mechanic
        </h1>
        <p class="text-xl text-accent font-semibold mb-2">
          Clear guidance for common car questions.
        </p>
        <p class="text-lg text-foreground/70 max-w-2xl mx-auto">
          Find practical information about car troubleshooting, maintenance, and tools, with clear limits on what a general guide can tell you.
        </p>
      </div>
      
      <div class="flex justify-center gap-4 mb-12">
        <a href="/fix" class="inline-flex items-center rounded-lg bg-accent px-6 py-3 text-lg font-semibold text-white transition-colors hover:bg-accent-600">
          Start Troubleshooting
        </a>
        <a href="/learn" class="inline-flex items-center rounded-lg border border-foreground/20 bg-background px-6 py-3 text-lg font-semibold text-foreground transition-colors hover:bg-foreground/5">
          Learn the Basics
        </a>
      </div>
    </div>
  </section>

  <!-- What We Cover -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 bg-foreground/[.02]">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">What We Cover</h2>
      <p class="text-lg text-foreground/70">Browse guides by topic</p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      <!-- Fix & Troubleshoot -->
      <div class="rounded-2xl border border-red-500/20 bg-gradient-to-br from-red-500/5 to-transparent p-8">
        <div class="mb-4">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-red-500 text-white mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground mb-2">Fix & Troubleshoot</h3>
          <p class="text-foreground/70">
            Start with common symptoms and checks, then see when a problem needs professional diagnosis.
          </p>
        </div>
        <a href="/fix" class="text-red-600 hover:text-red-700 font-medium">
          Start Diagnosing →
        </a>
      </div>

      <!-- Maintain & Prevent -->
      <div class="rounded-2xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-transparent p-8">
        <div class="mb-4">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500 text-white mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground mb-2">Maintain & Prevent</h3>
          <p class="text-foreground/70">
            Explore maintenance topics such as oil changes and tire care. Check the procedure and specifications for your exact vehicle.
          </p>
        </div>
        <a href="/maintain" class="text-emerald-600 hover:text-emerald-700 font-medium">
          Learn Maintenance →
        </a>
      </div>

      <!-- Buy & Compare -->
      <div class="rounded-2xl border border-blue-500/20 bg-gradient-to-br from-blue-500/5 to-transparent p-8">
        <div class="mb-4">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-blue-500 text-white mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground mb-2">Buy & Compare</h3>
          <p class="text-foreground/70">
            Compare information about automotive tools and parts. Confirm fitment and current product details with the manufacturer.
          </p>
        </div>
        <a href="/buy" class="text-blue-600 hover:text-blue-700 font-medium">
          Shop Smarter →
        </a>
      </div>

      <!-- Learn -->
      <div class="rounded-2xl border border-purple-500/20 bg-gradient-to-br from-purple-500/5 to-transparent p-8">
        <div class="mb-4">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-purple-500 text-white mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground mb-2">Learn</h3>
          <p class="text-foreground/70">
            Read explanations of vehicle systems, diagnostic codes, and maintenance terms.
          </p>
        </div>
        <a href="/learn" class="text-purple-600 hover:text-purple-700 font-medium">
          Build Knowledge →
        </a>
      </div>

      <!-- Seasonal -->
      <div class="rounded-2xl border border-amber-500/20 bg-gradient-to-br from-amber-500/5 to-transparent p-8">
        <div class="mb-4">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500 text-white mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground mb-2">Seasonal</h3>
          <p class="text-foreground/70">
            Browse seasonal vehicle-care topics and check which items apply to your climate and vehicle.
          </p>
        </div>
        <a href="/seasonal" class="text-amber-600 hover:text-amber-700 font-medium">
          Seasonal Prep →
        </a>
      </div>

      <!-- Starting points -->
      <div class="rounded-2xl border border-gray-500/20 bg-gradient-to-br from-gray-500/5 to-transparent p-8">
        <div class="mb-4">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-gray-500 text-white mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground mb-2">Start Here</h3>
          <p class="text-foreground/70">
            A few guides covering common questions about starting, maintenance, and diagnostic tools.
          </p>
        </div>
        <div class="space-y-2">
          <a href="/fix/car-wont-start-clicks" class="block text-sm text-foreground/70 hover:text-foreground">
            • Car Won't Start but Clicks
          </a>
          <a href="/maintain/how-to-change-oil-toyota-camry" class="block text-sm text-foreground/70 hover:text-foreground">
            • How to Change Oil (Toyota Camry)
          </a>
          <a href="/buy/best-obd2-scanners-2026" class="block text-sm text-foreground/70 hover:text-foreground">
            • Best OBD2 Scanners
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Before you begin -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid gap-12 lg:grid-cols-2 items-center">
      <div>
        <h2 class="text-3xl font-bold text-foreground mb-6">
          Before You Begin
        </h2>
        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500 text-white shrink-0">
              <span class="text-xl">🚗</span>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-foreground mb-2">Confirm the Vehicle</h3>
              <p class="text-foreground/70">
                Year, model, engine, and equipment can affect the right procedure. Check your owner's manual and use information that matches your vehicle.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-500 text-white shrink-0">
              <span class="text-xl">🧠</span>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-foreground mb-2">Check the Procedure</h3>
              <p class="text-foreground/70">
                Verify specifications and steps with current manufacturer service information. A general guide cannot inspect your car or confirm a diagnosis.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-purple-500 text-white shrink-0">
              <span class="text-xl">⏰</span>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-foreground mb-2">Know When to Stop</h3>
              <p class="text-foreground/70">
                Pause if a step is unclear, required equipment is missing, or the work is beyond your tools or experience. A qualified technician can help.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:text-center">
        <div class="inline-block rounded-2xl border border-foreground/10 bg-foreground/[.02] p-8">
          <h3 class="text-2xl font-bold text-foreground mb-6">A Safer Starting Point</h3>
          <p class="text-foreground/70">
            Confirm the vehicle, find the applicable service procedure, gather the specified equipment, and make sure your work area is suitable before beginning.
          </p>
          <p class="mt-4 text-sm text-foreground/60">
            If any safety step or fitment detail is uncertain, stop and get qualified help.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
