---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Article from "../../layouts/Article.astro";

export const getStaticPaths = (async () => {
  const FIX_HUBS = ["electrical", "engine", "brakes", "ac-heating", "suspension", "noises-smells", "exhaust", "transmission", "battery", "cooling"];
  const articles = await getCollection("articles", ({ data }) => {
    const inFixHub = data.hubs.some((h: string) => FIX_HUBS.includes(h));
    const isTroubleshooting = data.articleType === "troubleshooting";
    return (inFixHub || isTroubleshooting) && !data.draft;
  });

  return articles.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
---

<Article frontmatter={entry.data}>
  <Content />
</Article>
