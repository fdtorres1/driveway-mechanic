---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found" noIndex={true}>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-24 text-center">
    <div class="mb-8">
      <span class="text-6xl">🔧</span>
    </div>
    <h1 class="text-5xl font-bold text-foreground mb-4">404</h1>
    <p class="text-xl text-foreground/70 mb-2">Page not found</p>
    <p class="text-foreground/60 mb-8">
      Looks like this page took a wrong turn. It might have been moved, removed, 
      or the URL might be incorrect.
    </p>
    
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a href="/" class="inline-flex items-center justify-center rounded-lg bg-accent px-6 py-3 font-semibold text-white hover:bg-accent-600 transition-colors">
        Back to Home
      </a>
      <a href="/fix" class="inline-flex items-center justify-center rounded-lg border border-foreground/20 px-6 py-3 font-semibold text-foreground hover:bg-foreground/5 transition-colors">
        Troubleshoot a Problem
      </a>
    </div>

    <div class="mt-12 rounded-2xl border border-foreground/10 bg-foreground/[.02] p-6">
      <h2 class="text-lg font-semibold text-foreground mb-4">Popular Guides</h2>
      <div class="grid gap-3 sm:grid-cols-3 text-sm">
        <a href="/fix/car-wont-start-clicks" class="rounded-lg border border-foreground/10 p-3 hover:bg-foreground/[.02] transition-colors">
          <div class="font-medium text-foreground">Car Won't Start</div>
          <div class="text-foreground/60 mt-1">Diagnose clicking issues</div>
        </a>
        <a href="/maintain/how-to-change-oil-toyota-camry" class="rounded-lg border border-foreground/10 p-3 hover:bg-foreground/[.02] transition-colors">
          <div class="font-medium text-foreground">Oil Change Guide</div>
          <div class="text-foreground/60 mt-1">Step-by-step tutorial</div>
        </a>
        <a href="/buy/best-obd2-scanners-2026" class="rounded-lg border border-foreground/10 p-3 hover:bg-foreground/[.02] transition-colors">
          <div class="font-medium text-foreground">Best OBD2 Scanners</div>
          <div class="text-foreground/60 mt-1">2026 buyer guide</div>
        </a>
      </div>
    </div>
  </div>
</Layout>
