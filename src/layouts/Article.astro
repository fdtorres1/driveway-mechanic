---
import Layout from "./Layout.astro";
import TimeCostSkill from "../components/mdx/TimeCostSkill.astro";
import VehicleFitment from "../components/mdx/VehicleFitment.astro";
import { getSection } from "../lib/hubs";

export interface Props {
  frontmatter: {
    title: string;
    excerpt?: string;
    publishedAt?: Date;
    updatedAt?: Date;
    author?: string;
    hubs?: string[];
    hub?: string;
    vehicles?: string[];
    difficulty?: string;
    articleType?: string;
    timeCostSkill?: {
      time: string;
      diyCost: string;
      shopCost: string;
      skill: "beginner" | "intermediate" | "advanced";
      notes?: string;
    };
    seo?: {
      title?: string;
      description?: string;
      canonicalUrl?: string;
      noIndex?: boolean;
    };
  };
}

const { frontmatter } = Astro.props;

const siteUrl = "https://drivewaymechanicguide.com";
const primaryHub = frontmatter.hubs?.[0] || frontmatter.hub || "articles";

const section = getSection([primaryHub]);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: section.label, href: section.href },
];

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};

const isHowTo = frontmatter.articleType === "how-to";

const pageUrl = `${siteUrl}${section.href}/${Astro.url.pathname.split('/').filter(Boolean).pop()}`;

const articleJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": isHowTo ? "HowTo" : "Article",
  headline: frontmatter.title,
  description: frontmatter.seo?.description || frontmatter.excerpt,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  ...(frontmatter.publishedAt && { datePublished: frontmatter.publishedAt.toISOString() }),
  ...(frontmatter.updatedAt && { dateModified: frontmatter.updatedAt.toISOString() }),
  author: {
    "@type": "Organization",
    name: frontmatter.author || "The Driveway Mechanic",
  },
  publisher: {
    "@type": "Organization",
    name: "The Driveway Mechanic",
    url: siteUrl,
  },
  image: `${siteUrl}/og-default.jpg`,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((crumb, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: crumb.label,
    item: `${siteUrl}${crumb.href}`,
  })),
};
---

<Layout 
  title={frontmatter.seo?.title || frontmatter.title}
  description={frontmatter.seo?.description || frontmatter.excerpt}
  canonical={frontmatter.seo?.canonicalUrl}
  noIndex={frontmatter.seo?.noIndex}
  jsonLd={articleJsonLd}
>
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-foreground/60">
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span>/</span>}
            <a href={crumb.href} class="hover:text-foreground">{crumb.label}</a>
          </li>
        ))}
      </ol>
    </nav>

    <!-- Article Header -->
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-4">{frontmatter.title}</h1>
      
      {frontmatter.excerpt && (
        <p class="text-lg text-foreground/70 mb-6">{frontmatter.excerpt}</p>
      )}

      <!-- Article Meta -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-foreground/60 mb-6">
        {frontmatter.author && (
          <div class="flex items-center gap-2">
            <span>👤</span>
            <span>{frontmatter.author}</span>
          </div>
        )}
        
        {frontmatter.publishedAt && (
          <div class="flex items-center gap-2">
            <span>📅</span>
            <time datetime={frontmatter.publishedAt.toISOString()}>
              {formatDate(frontmatter.publishedAt)}
            </time>
          </div>
        )}

        {frontmatter.updatedAt && (
          <div class="flex items-center gap-2">
            <span>🔄</span>
            <span>Updated {formatDate(frontmatter.updatedAt)}</span>
          </div>
        )}

        {frontmatter.difficulty && (
          <div class="flex items-center gap-2">
            <span>🎯</span>
            <span class="capitalize">{frontmatter.difficulty}</span>
          </div>
        )}
      </div>

      <!-- Vehicle Fitment -->
      {frontmatter.vehicles && frontmatter.vehicles.length > 0 && (
        <VehicleFitment vehicles={frontmatter.vehicles} />
      )}

      <!-- Time, Cost & Skill -->
      {frontmatter.timeCostSkill && (
        <TimeCostSkill {...frontmatter.timeCostSkill} />
      )}
    </header>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

    <!-- Article Content -->
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    <!-- Article Footer -->
    <footer class="mt-12 border-t border-foreground/10 pt-8">
      <div class="rounded-xl bg-foreground/[.02] p-6">
        <div class="flex items-start gap-3">
          <span class="text-2xl">⚠️</span>
          <div>
            <h3 class="text-lg font-semibold text-foreground mb-2">Safety Disclaimer</h3>
            <p class="text-sm text-foreground/70">
              Working on vehicles can be dangerous. This guide is for informational purposes only. 
              Always prioritize safety, use proper protective equipment, and consult a qualified 
              professional if you're not comfortable with any procedure. The Driveway Mechanic 
              is not responsible for any injuries or damage resulting from following these instructions.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-6 text-center">
        <p class="text-sm text-foreground/60">
          Found this helpful? Share it with a fellow DIY mechanic! 🔧
        </p>
      </div>
    </footer>
  </article>
</Layout>